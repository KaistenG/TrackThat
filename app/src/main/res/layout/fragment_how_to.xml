<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Anleitung"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:textColor="#BB86FC"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gewohnheiten anlegen"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:textColor="#BB86FC"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tippe auf Gewohnheiten und dann auf das + Symbol um eine neue Gewohnheit anzulegen. Gib ihr einen Namen, weise sie einer Gruppe/Richtung zu und suche dir dann deine passende Farbe."
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gewohnheiten tracken"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:textColor="#BB86FC"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tippe auf einen Tag im Kalender oder auf die Heute-Kachel um deine Gewohnheiten für diesen Tag einzutragen."
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visualisierung"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:textColor="#BB86FC"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vertikale Streifen eignen sich für wöchentliche Aktivitäten wie Sport. Horizontale Streifen für tägliche Gewohnheiten wie in etwa ausreichend Wasser trinken. Durch eine leichte Einfärbung der Kacheln, kann man auch seine allgemeine Tagesstimmung tracken."
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reihenfolge anpassen"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:textColor="#BB86FC"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Halte eine Gewohnheit gedrückt und verschiebe sie an deine gewünschte Position. Die Reihenfolge bestimmt die Position der Streifen im Kalender."
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Statistiken"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:textColor="#BB86FC"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unter Statistiken findest du eine Übersicht deines aktuellen Monats, Vergleiche mit dem Durchschnitt und dem Topmonat, sowie deine aktuellen Streaks."
            android:lineSpacingMultiplier="1.4"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</ScrollView>