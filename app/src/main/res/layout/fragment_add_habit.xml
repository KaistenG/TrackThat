<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editTextName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="z.B. Muay Thai"
            android:inputType="textCapSentences"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Typ"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/radioGroupVisualType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/radioVertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weekly (z.B. Sport)"
                android:checked="true"
                android:padding="8dp"/>

            <RadioButton
                android:id="@+id/radioHorizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily (z.B. Wasser trinken)"
                android:padding="8dp"/>

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Farbe"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <GridLayout
            android:id="@+id/colorGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="6"
            android:rowCount="2"
            android:layout_marginBottom="24dp">

            <View android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="#FF3B3B" android:tag="#FF3B3B"/>
            <View android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="#FF6B00" android:tag="#FF6B00"/>
            <View android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="#FFD000" android:tag="#FFD000"/>
            <View android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="#00E054" android:tag="#00E054"/>
            <View android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="#00DDDD" android:tag="#00DDDD"/>
            <View android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="#1A7FFF" android:tag="#1A7FFF"/>
            <View android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="#AA00FF" android:tag="#AA00FF"/>
            <View android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="#FF00CC" android:tag="#FF00CC"/>
            <View android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="#FF0077" android:tag="#FF0077"/>
            <View android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="#FFFFFF" android:tag="#FFFFFF"/>
            <View android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="#FF9500" android:tag="#FF9500"/>
            <View android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:background="#00FF88" android:tag="#00FF88"/>

        </GridLayout>

        <CheckBox
            android:id="@+id/checkBoxStreakable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Streak verfolgen"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="Speichern"
            android:textColor="#FFFFFF"
            app:icon="@drawable/ic_save"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"
            app:backgroundTint="#3700B3"
            style="@style/Widget.Material3.Button"/>

    </LinearLayout>

</ScrollView>