<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Impressum"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:textColor="#BB86FC"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:textColor="#BB86FC"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AbbenTrack"
            android:layout_marginBottom="4dp"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version 1.0"
            android:layout_marginBottom="24dp"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entwickler"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:textColor="#BB86FC"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kai Steen"
            android:layout_marginBottom="24dp"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hinweis"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:textColor="#BB86FC"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diese App wurde im Rahmen des Moduls Agile Softwareentwicklung der IU Internationale Hochschule entwickelt."
            android:lineSpacingMultiplier="1.4"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</ScrollView>